# ─────────────────────────────────────────────
# LMS Backend — Environment Variables
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL (Sequelize)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=lms_password

# MongoDB (Mongoose)
MONGO_URI=mongodb://localhost:27017/lms_mongo

# JWT Authentication
JWT_SECRET=supersecretjwtkey_lms_2024
JWT_EXPIRES_IN=7d

# Deno Microservice
DENO_SERVICE_URL=http://localhost:8000

# Stripe (sandbox / mock)
STRIPE_SECRET_KEY=sk_test_mock_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
